# Home lab: prometheus-pve-exporter (PyPI, venv in /opt/prometheus-pve-exporter).
# Reads pve01 with the read-only API token in /etc/prometheus/pve.yml and serves metrics to Prometheus on localhost only.
[Unit]
Description=Prometheus exporter for Proxmox VE (pve01, read-only token)
After=network-online.target
Wants=network-online.target

[Service]
User=pve-exporter
Group=pve-exporter
ExecStart=/opt/prometheus-pve-exporter/bin/pve_exporter --config.file /etc/prometheus/pve.yml --web.listen-address 127.0.0.1:9221
Restart=on-failure
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
